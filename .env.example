NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Hệ thống xét duyệt thành tích Khoa CNTT

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Chỉ đặt MỘT trong hai biến server secret dưới đây.
# Ưu tiên SUPABASE_SECRET_KEY với dự án mới.
SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_SERVICE_ROLE_KEY=legacy_service_role_key

# Chỉ dùng để hiển thị cho người đăng ký; SMTP thực tế cấu hình trong Supabase.
NEXT_PUBLIC_AUTH_EMAIL_SENDER_ADDRESS=xacnhan@your-domain.example
ALLOWED_REVIEWER_DOMAIN=dntu.edu.vn

GOOGLE_APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_APPS_SCRIPT_SHARED_SECRET=your_long_random_shared_secret
MAX_IMAGE_SIZE_MB=4
PUBLIC_SIGNUP_ENABLED=false\n

