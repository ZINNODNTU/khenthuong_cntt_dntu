{
  "framework": "nextjs",
  "regions": ["sin1"],
  "installCommand": "corepack enable && corepack prepare pnpm@10.34.5 --activate && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm exec next build",
  "functions": {
    "app/api/evidence/upload/route.ts": { "maxDuration": 60 },
    "app/api/evidence/[id]/route.ts": { "maxDuration": 60 },
    "app/api/cron/storage-cleanup/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/storage-cleanup", "schedule": "0 3 * * *" }
  ]
}
