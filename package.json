{
  "name": "cntt-award-review-system",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "preinstall": "node scripts/require-pnpm.mjs",
    "generate-storage-secret": "node scripts/generate-storage-secret.mjs",
    "verify": "node scripts/verify-clean-release.mjs",
    "storage:check": "node scripts/check-image-storage.mjs",
    "storage:smoke": "node scripts/smoke-apps-script-storage.mjs",
    "supabase:check": "node scripts/check-supabase-connection.mjs",
    "supabase:sql": "node scripts/build-supabase-install.mjs",
    "db:verify": "node scripts/verify-database-files.mjs",
    "check": "pnpm run verify && pnpm run db:verify && pnpm run ui:self-check && pnpm run ui:verify && pnpm run auth:verify && pnpm run auth:uniqueness:verify && pnpm run typecheck && pnpm run criteria:test",
    "ui:self-check": "node scripts/ui-self-check.mjs",
    "ui:verify": "node scripts/verify-modern-ui.mjs",
    "auth:verify": "node scripts/verify-login-smtp.mjs",
    "auth:templates:check": "node scripts/publish-supabase-email-templates.mjs --check",
    "auth:uniqueness:verify": "node scripts/verify-student-account-uniqueness.mjs",
    "auth:duplicates:audit": "node scripts/audit-duplicate-student-accounts.mjs",
    "ui:audit": "playwright test tests/ui-audit.spec.ts",
    "ui:audit:headed": "playwright test tests/ui-audit.spec.ts --headed",
    "ui:motion-audit": "playwright test tests/motion-audit.spec.ts",
    "criteria:test": "node --experimental-strip-types --test tests/criteria-rules.test.mjs tests/criterion-evidence.test.mjs tests/report-csv.test.mjs tests/award-scoring.test.mjs tests/award-criteria.test.mjs tests/period-dates.test.mjs tests/security-hardening.test.mjs tests/upload-retry.test.mjs tests/evidence-entry-ledger.test.mjs tests/collective-award-criteria.test.mjs tests/collective-criteria-migration.test.mjs tests/apps-script-gateway.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.42.2",
    "lucide-react": "1.25.0",
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  }
}
